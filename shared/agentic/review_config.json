{
  "feature_name": "Shared ASD Group Services",
  "contributor": "ASD 2026 Team",
  "prompt_file": "review_prompt.txt",
  "mode_prompt_files": {
    "multi-agent": "multi_agent_prompt.txt",
    "testing": "testing_prompt.txt",
    "cloud-deployment": "cloud_deployment_prompt.txt"
  },
  "multi-agent_files": [
    "ai-services/multi_agent_server/app.py",
    "ai-services/multi_agent_server/config.py",
    "ai-services/multi_agent_server/contracts.py",
    "ai-services/multi_agent_server/coordinator.py",
    "ai-services/multi_agent_server/evidence_context.py",
    "ai-services/multi_agent_server/model_client.py",
    "ai-services/multi_agent_server/workflow_store.py",
    "ai-services/multi_agent_server/workflow_runner.py",
    "ai-services/multi_agent_server/agents/planner_agent.py",
    "ai-services/multi_agent_server/agents/worker_agent.py",
    "ai-services/multi_agent_server/agents/reviewer_agent.py",
    "ai-services/multi_agent_server/tests/test_coordinator.py",
    "ai-services/multi_agent_server/tests/test_app.py",
    "docker-compose.yml"
  ],
  "multi_agent_server_url": "http://127.0.0.1:5004",
  "multi_agent_timeout_seconds": 10,
  "multi_agent_rules": {
    "required_agents": [
      "planner",
      "worker",
      "reviewer"
    ],
    "required_features": [
      "product_catalogue",
      "inventory",
      "customer_loyalty",
      "order_returns",
      "customer_support"
    ],
    "required_endpoints": [
      "/health",
      "/api/workflows",
      "/api/workflows/latest",
      "/api/workflows/<workflow_id>",
      "/api/workflows/<workflow_id>/review"
    ],
    "source_files": {
      "server": "ai-services/multi_agent_server/app.py",
      "contracts": "ai-services/multi_agent_server/contracts.py",
      "coordinator": "ai-services/multi_agent_server/coordinator.py",
      "store": "ai-services/multi_agent_server/workflow_store.py",
      "planner": "ai-services/multi_agent_server/agents/planner_agent.py",
      "worker": "ai-services/multi_agent_server/agents/worker_agent.py",
      "reviewer": "ai-services/multi_agent_server/agents/reviewer_agent.py",
      "compose": "docker-compose.yml"
    },
    "log_files": {
      "history": "ai-services/multi_agent_server/workflow_history.jsonl",
      "audit": "ai-services/multi_agent_server/coordination_audit.jsonl"
    }
  },
  "source_checks": {
    "multi-agent": [
      {
        "name": "coordinator_runs_three_agents_in_order",
        "file": "ai-services/multi_agent_server/coordinator.py",
        "contains": [
          "self._planner.plan(",
          "self._worker.execute(",
          "self._reviewer.review("
        ]
      },
      {
        "name": "contracts_support_all_group_features",
        "file": "ai-services/multi_agent_server/contracts.py",
        "contains": [
          "product_catalogue",
          "inventory",
          "customer_loyalty",
          "order_returns",
          "customer_support"
        ]
      },
      {
        "name": "server_exposes_workflow_and_human_review_routes",
        "file": "ai-services/multi_agent_server/app.py",
        "contains": [
          "@app.get(\"/health\")",
          "@app.post(\"/api/workflows\")",
          "@app.get(\"/api/workflows/latest\")",
          "@app.post(\"/api/workflows/<workflow_id>/review\")"
        ]
      },
      {
        "name": "store_requires_and_records_human_review",
        "file": "ai-services/multi_agent_server/workflow_store.py",
        "contains": [
          "awaiting_human_review",
          "human_review_recorded",
          "must require human approval"
        ]
      },
      {
        "name": "tests_cover_coordinator_and_http_contract",
        "file": "ai-services/multi_agent_server/tests/test_app.py",
        "contains": [
          "test_health_is_lightweight_and_does_not_run_workflow",
          "/api/workflows",
          "/review"
        ]
      }
    ]
  },
  "testing_rules": {
    "manifest": "docs/evidence/release2-testing-manifest.json",
    "required_features": [
      "product_catalogue",
      "inventory",
      "customer_loyalty",
      "order_returns",
      "customer_support"
    ],
    "expected_endpoints": {
      "product_catalogue": [
        {
          "function": "get_products",
          "method": "GET",
          "path": "/api/products",
          "test_node_id": "student-Chufeng/tests/test_catalogue.py::test_get_and_search_products"
        },
        {
          "function": "create_cart_item",
          "method": "POST",
          "path": "/api/cart-items",
          "test_node_id": "student-Chufeng/tests/test_catalogue.py::test_add_cart_item"
        }
      ],
      "inventory": [
        {
          "function": "create_product",
          "method": "POST",
          "path": "/api/inventory/products",
          "test_node_id": "student-Ryan_Nolan/tests/inventory_tests.py::test_create_product"
        },
        {
          "function": "update_product",
          "method": "PUT",
          "path": "/api/inventory/products/<int:product_id>",
          "test_node_id": "student-Ryan_Nolan/tests/inventory_tests.py::test_update_product"
        }
      ],
      "customer_loyalty": [
        {
          "function": "register",
          "method": "POST",
          "path": "/api/register",
          "test_node_id": "student-Ethan Ting/tests/test_login_system.py::test_customer_registration_creates_customer_session"
        },
        {
          "function": "create_loyalty_adjustment",
          "method": "POST",
          "path": "/api/admin/loyalty/<int:user_id>/adjustments",
          "test_node_id": "student-Ethan Ting/tests/test_login_system.py::test_admin_adjustment_includes_authenticated_admin_id"
        }
      ],
      "order_returns": [
        {
          "function": "create_order",
          "method": "POST",
          "path": "/api/order-returns/orders",
          "test_node_id": "student-Howard/tests/test_api.py::test_create_order"
        },
        {
          "function": "create_return",
          "method": "POST",
          "path": "/api/order-returns/returns",
          "test_node_id": "student-Howard/tests/test_api.py::test_create_return"
        }
      ],
      "customer_support": [
        {
          "function": "customer_create",
          "method": "POST",
          "path": "/api/support/customer/tickets",
          "test_node_id": "student-Ethan Goldman/tests/test_release2_endpoint_functions.py::test_customer_create_contract"
        },
        {
          "function": "admin_update",
          "method": "PUT",
          "path": "/api/support/admin/tickets/<int:ticket_id>",
          "test_node_id": "student-Ethan Goldman/tests/test_release2_endpoint_functions.py::test_admin_update_contract"
        }
      ]
    },
    "accepted_dependency_advisories": [
      "PYSEC-2026-311",
      "PYSEC-2026-3813",
      "PYSEC-2026-3814",
      "PYSEC-2026-3815"
    ]
  },
  "cloud_deployment_rules": {
    "manifest": "docs/evidence/release2-cloud-deployment-manifest.json",
    "required_workflows": [
      ".github/workflows/EthanGoldman.yml",
      ".github/workflows/Chufeng.yml",
      ".github/workflows/Ryan.yml",
      ".github/workflows/student-3.yml",
      ".github/workflows/Howard.yml"
    ]
  }
}

{
  "feature_name": "Chufeng - Product Catalogue and Shopping Cart",
  "prompt_file": "review_prompt.txt",
  "mode_prompt_files": {
    "database": "database_prompt.txt",
    "endpoints": "endpoints_prompt.txt",
    "architecture": "architecture_prompt.txt",
    "implementation": "implementation_prompt.txt",
    "devops": "devops_prompt.txt",
    "mcp": "mcp_prompt.txt"
  },
  "database": "student-Chufeng/database/products.db",
  "endpoints": [
    {
      "name": "Product Catalogue API",
      "url": "http://localhost:5000/api/products"
    },
    {
      "name": "Shopping Cart API",
      "url": "http://localhost:5000/api/cart-items"
    }
  ],
  "architecture_files": [
    "app.py",
    "docker-compose.yml",
    "student-Chufeng/Dockerfile",
    "student-Chufeng/database/schema.sql",
    "student-Chufeng/frontend/index.html",
    "student-Chufeng/frontend/js/products.js",
    "student-Chufeng/backend/routes/product_routes.py",
    "student-Chufeng/backend/routes/cart_routes.py",
    "student-Chufeng/backend/routes/ai_routes.py",
    "student-Chufeng/backend/controllers/product_controller.py",
    "student-Chufeng/backend/controllers/cart_controller.py",
    "student-Chufeng/backend/controllers/ai_controller.py",
    "student-Chufeng/backend/models/product_model.py",
    "student-Chufeng/backend/models/cart_model.py"
  ],
  "implementation_files": [
    "student-Chufeng/frontend/js/products.js",
    "student-Chufeng/frontend/js/cart.js",
    "student-Chufeng/backend/routes/product_routes.py",
    "student-Chufeng/backend/routes/cart_routes.py",
    "student-Chufeng/backend/routes/ai_routes.py",
    "student-Chufeng/backend/controllers/product_controller.py",
    "student-Chufeng/backend/controllers/cart_controller.py",
    "student-Chufeng/backend/controllers/ai_controller.py",
    "student-Chufeng/backend/models/database.py",
    "student-Chufeng/backend/models/product_model.py",
    "student-Chufeng/backend/models/cart_model.py",
    "student-Chufeng/tests/test_catalogue.py"
  ],
  "devops_files": [
    ".github/workflows/Chufeng.yml",
    "docker-compose.yml",
    "student-Chufeng/Dockerfile",
    "shared/Dockerfile.backend",
    "shared/nginx/product-catalogue.conf",
    "student-Chufeng/tests/test_catalogue.py",
    "student-Chufeng/tests/test_agentic_loop.py"
  ],
  "mcp_files": [
    "ai-services/mcp_server/server.py",
    "ai-services/mcp_server/tools/chufeng_catalogue.py",
    "ai-services/mcp_server/response.py",
    "student-Chufeng/backend/services/mcp_client.py",
    "student-Chufeng/backend/controllers/mcp_controller.py",
    "student-Chufeng/backend/routes/mcp_routes.py",
    "student-Chufeng/frontend/mcp-assistant.html",
    "student-Chufeng/frontend/js/mcp-tools.js",
    "docker-compose.yml",
    ".github/workflows/Chufeng.yml"
  ],
  "mcp_server_url": "http://127.0.0.1:8765/mcp",
  "mcp_rules": {
    "required_tools": [
      "chufeng_search_products",
      "chufeng_get_product_details",
      "chufeng_check_product_stock",
      "chufeng_calculate_cart_summary"
    ],
    "probe_tool": "chufeng_search_products",
    "probe_arguments": {
      "query": "",
      "limit": 1
    }
  },
  "source_checks": {
    "mcp": [
      {
        "name": "server_uses_read_only_annotations",
        "file": "ai-services/mcp_server/server.py",
        "contains": [
          "readOnlyHint=True",
          "destructiveHint=False",
          "structured_output=True"
        ]
      },
      {
        "name": "tools_use_database_api_without_sqlite",
        "file": "ai-services/mcp_server/tools/chufeng_catalogue.py",
        "contains": [
          "requests.get",
          "metadata={\"read_only\": True}"
        ],
        "excludes": [
          "import sqlite3"
        ]
      },
      {
        "name": "backend_enforces_tool_allowlist",
        "file": "student-Chufeng/backend/services/mcp_client.py",
        "contains": [
          "CHUFENG_ALLOWED_TOOLS",
          "MCPToolNotAllowedError"
        ]
      },
      {
        "name": "frontend_calls_backend_mcp_routes",
        "file": "student-Chufeng/frontend/js/mcp-tools.js",
        "contains": [
          "/api/chufeng/mcp/",
          "X-MCP-Mode"
        ],
        "excludes": [
          "127.0.0.1:8765",
          "localhost:8765"
        ]
      },
      {
        "name": "docker_calls_host_mcp_server",
        "file": "docker-compose.yml",
        "contains": [
          "host.docker.internal:8765/mcp",
          "host.docker.internal:host-gateway"
        ]
      },
      {
        "name": "ci_disables_live_mcp",
        "file": ".github/workflows/Chufeng.yml",
        "contains": [
          "MCP_ENABLED: \"false\"",
          "ai-services/mcp_server/tests"
        ],
        "excludes": [
          "docker compose up",
          "ollama pull"
        ]
      }
    ]
  }
}
